pipeline {
    agent {
        docker {
           image 'maven-with-docker'
           // Use the DinD container via host port for Docker access in the agent
           args "-e DOCKER_HOST=tcp://host.docker.internal:2375 -e DOCKER_TLS_VERIFY=0 -e DOCKER_CERT_PATH="
        }
    }

    stages {
        stage('Build') {
            steps {
                echo 'Building Maven project...'
                sh 'mvn -DskipTests clean package'
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                sh 'mvn test'
            }
        }
    }
}
