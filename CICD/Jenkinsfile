pipeline {
    environment {
        DOCKER_HOST = "tcp://host.docker.internal:2375"
        DOCKER_TLS_VERIFY = "0"
        TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE = "tcp://host.docker.internal:2375"
    }

    agent {
        docker {
            image 'maven:3.9.8-eclipse-temurin-17'
            args '--add-host=host.docker.internal:host-gateway'
        }
    }

    stages {
        stage('Verify Docker API') {
            steps {
                sh 'echo DOCKER_HOST=$DOCKER_HOST'
                sh 'curl http://host.docker.internal:2375/version'
            }
        }

        stage('Build') {
            steps {
                sh 'mvn -DskipTests clean package'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }
    }
}
