pipeline {
    agent {
        docker {
           image 'maven-with-docker'
           // Mount host Docker socket and set Docker env vars so the
           // container can use the host's Docker daemon without TLS certs.
           // Adjust paths as needed for your Jenkins host.
           args "--user 0:1001 -e HOME=/root -e DOCKER_HOST=unix:///var/run/docker.sock -e DOCKER_TLS=0 -e DOCKER_TLS_VERIFY=0 -e DOCKER_TLS_CERTDIR="
        }
    }

    stages {
        stage('Build') {
            steps {
                echo 'Building Maven project...'
                sh 'mvn -DskipTests clean package'
            }
        }

        stage('Test') {
            steps {
                sh 'echo HOME=$HOME'
                sh 'echo DOCKER_HOST=$DOCKER_HOST'
                sh 'echo DOCKER_CONFIG=$DOCKER_CONFIG || echo DOCKER_CONFIG not set'
                sh 'echo ~/.docker'
                sh 'ls -la ~/.docker 2>/dev/null || echo no .docker dir'
                sh 'ls -la /certs'
                sh 'docker version'
                sh 'mvn test -Dtestcontainers.debug=true'
            }
        }
    }
}
