pipeline {
    environment {
        DOCKER_HOST=tcp://docker:2376
        DOCKER_TLS_VERIFY=1
        DOCKER_CERT_PATH=/certs/client
    }

    agent {
        docker {
            image 'maven:3.9.8-eclipse-temurin-17'
        }
    }

    stages {
        stage('Build') {
            steps {
                sh 'mvn -DskipTests clean package'
            }
        }

        stage('Test') {
            steps {
                sh 'mvn test'
            }
        }
    }
}
