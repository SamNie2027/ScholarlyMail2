    agent {
        docker {
            image 'maven:3.9.8-eclipse-temurin-17'
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }
    options {
        skipStagesAfterUnstable()
    }
    stages {
        stage('Build') {
            steps {
                sh 'mvn -DskipTests clean package '
            }
        }
        stage('Test'){
            steps {
                sh 'mvn test'
            }
        }
